# Copy to .env.local (not committed) and adjust. All flags default to off.

# Show the sample customer reviews on the home page and product pages.
# Leave off until real, approved reviews exist.
VITE_SHOW_SAMPLE_REVIEWS=false

# Allow search engines to index the site. Off: every page gets noindex, robots.txt
# disallows everything and no sitemap.xml is produced. Turn on at launch.
VITE_INDEXABLE=false

# Production origin, used for canonical links, social images and the sitemap.
SITE_URL=https://www.example.com
